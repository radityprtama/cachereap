{
  "name": "cachereap",
  "version": "0.2.0",
  "description": "Cleanup tool for Fedora/Next.js/Bun dev machines. Faithful TS port of cachereap.sh.",
  "type": "module",
  "bin": {
    "cachereap": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cleanup",
    "fedora",
    "nextjs",
    "bun",
    "disk",
    "maintenance"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "conf": "^15.1.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
